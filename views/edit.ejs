<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="main p-10 w-full min-h-screen bg-zinc-900">
        <a class="text-blue-500 inline-block mb-10" href="/">go back to home</a>
         <form action="/edit" method="post">
            <input class= "block rounded-md w-1/4 outline-none text-white px-5 py-2 bg-zinc-800"type="text" placeholder="previous name" name ="previous" value="<%= filename %>" >
            <textarea class= "block rounded-md w-1/4 outline-none  text-white px-5 resize-none py-2 bg-zinc-800 mt-2 "placeholder="new name" name ="new"></textarea>
            <input  class="mt-2 bg-yellow-600 px-5 py-2 rounded-md " type="submit" value="update task">
        </form> 
        </div>
    
    
</body>
</html>